# ---- append to your Laravel .env ----
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Owner account created by the seeder (change the password immediately)
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=use-a-long-random-password

# Plan prices in pesos (leave empty to keep checkout disabled for that plan)
PRICE_PREMIUM=
PRICE_PREMIUM_PLUS=
PRICE_ALL_ACCESS=

# PayMongo (test keys first!). The webhook secret is shown when you create the webhook endpoint.
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx
PAYMONGO_METHODS=card,gcash,qrph

# Mail (needed for email verification, password reset and receipts)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME=LUMIBOOK

# Jobs: receipts are queued. Use "sync" locally, "database" or "redis" in production with a worker running.
QUEUE_CONNECTION=database
FAIR_USE_PER_HOUR=30
SANCTUM_TOKEN_EXPIRATION=10080

# Two-factor: require it for the owner account (turn this on in production)
REQUIRE_ADMIN_2FA=false
