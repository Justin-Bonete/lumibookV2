{$DOMAIN} {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'"
	}
	@laravel path /api/* /storage/* /up
	handle @laravel {
		root * /var/www/html/public
		php_fastcgi app:9000
		file_server
	}
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
